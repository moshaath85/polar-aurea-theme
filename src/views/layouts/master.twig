{#
| Variable              | Type    | Description                                              |
|-----------------------|---------|----------------------------------------------------------|
| store                 | Store   | store.name, store.logo, store.description, store.url ... |
| theme.settings.get()  | mixed   | read a setting from twilight.json                        |
| theme.is_rtl          | bool    | layout direction                                          |
| language.code         | string  | ar / en                                                   |
| page.title            | string  | current page title                                        |
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ page.title ? page.title ~ ' · ' ~ store.name : store.name }}{% endblock %}</title>
    <meta name="description" content="{{ store.description }}">

    <link rel="icon" href="{{ store.icon }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Manrope:wght@300;400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Noto+Kufi+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    {% block styles %}{% endblock %}

    <script>
        window.theme = {
            rtl: {{ theme.is_rtl ? 'true' : 'false' }},
            heroAutoplay: {{ theme.settings.get('hero_autoplay_ms', 7000) }},
            heroKenBurns: {{ theme.settings.get('hero_kenburns', true) ? 'true' : 'false' }}
        };
    </script>
    {% block head_scripts %}{% endblock %}
</head>

<body id="app" class="aurea {% hook 'body:classes' %}">

    {% component 'header.header' %}

    <main id="main">
        {% block content %}{% endblock %}
    </main>

    {% component 'footer.footer' %}

    <script defer src="{{ 'app.js' | asset }}"></script>
    {% block scripts %}{% endblock %}

    <salla-search data-testid="store-search-modal"></salla-search>
    <salla-login-modal data-testid="store-login-modal"></salla-login-modal>
    <salla-cart data-testid="store-cart-drawer"></salla-cart>
</body>
</html>
