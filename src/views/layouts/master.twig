{#
| Variable              | Type    | Description                                              |
|-----------------------|---------|----------------------------------------------------------|
| store                 | Store   | store.name, store.logo, store.description, store.url ...  |
| theme.settings.get()  | mixed   | read a setting from twilight.json                         |
| theme.is_rtl          | bool    | layout direction                                          |
| theme.font            | object  | available because the "fonts" feature is enabled          |
| theme.color           | object  | primary / darker() / lighter() / reverse_text             |
| language.code         | string  | ar / en                                                   |
| page.title            | string  | current page title                                        |
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{ theme.settings.set('placeholder', 'images/logo/polar-light.png') }}

    <title>{% block title %}{{ page.title ? page.title ~ ' · ' ~ store.name : store.name }}{% endblock %}</title>
    <meta name="description" content="{{ store.description }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Manrope:wght@300;400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Noto+Kufi+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
        window.themeAurea = {
            rtl: {{ theme.is_rtl ? 'true' : 'false' }},
            heroAutoplay: "{{ theme.settings.get('hero_autoplay_ms', 7000) }}",
            heroKenBurns: {{ theme.settings.get('hero_kenburns', true) ? 'true' : 'false' }}
        };
        window.header_is_sticky = "{{ theme.settings.get('header_is_sticky', true) }}";
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}";
    </script>

    {% block head_scripts %}{% endblock %}

    {% hook 'head:start' %}
    {% hook head %}

    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path | cdn }}">
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css' | cdn }}">

    <style>
        :root{
            --font-main: '{{ theme.font.name }}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
        }
    </style>

    {% hook 'head:end' %}
</head>

<body id="app" class="aurea {% hook 'body:classes' %}">

<noscript>
    <div style="padding:16px;text-align:center">
        {{ 'لتجربة كاملة، يرجى تفعيل JavaScript في المتصفح.' | trans }}
    </div>
</noscript>

<div class="app-inner">
    {% hook 'body:start' %}

    {% component 'header.header' %}

    <main id="main-content" role="main">
        {% block content %}{% endblock %}
    </main>

    {% component 'footer.footer' %}
</div>

{% hook 'body:end' %}

{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}

<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight core components — required by the storefront #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}

{% block scripts %}{% endblock %}
</body>
</html>
