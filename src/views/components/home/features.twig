{#
| items[]        | array  | list of features |
| items[].title  | string | title            |
| items[].text   | string | description      |
#}
{% set items = items ?? [] %}
{% if items|length %}
<section class="band" component-id="{{ componentId }}" data-testid="store-home-features">
    <div class="wrap band__in">
        {% for item in items %}
            <div class="band__cell reveal">
                <span class="band__icon">
                    {% if loop.index0 % 4 == 0 %}
                        <svg viewBox="0 0 24 24"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="6.5" cy="17" r="1.6"/><circle cx="17.5" cy="17" r="1.6"/></svg>
                    {% elseif loop.index0 % 4 == 1 %}
                        <svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 5 3.4 7.7 8 9 4.6-1.3 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                    {% elseif loop.index0 % 4 == 2 %}
                        <svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 0-3 6.2"/><path d="M20 7v5h-5"/></svg>
                    {% else %}
                        <svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 0 0-15-3"/><path d="M4 13a8 8 0 0 0 15 3"/><path d="M20 5v4h-4M4 19v-4h4"/></svg>
                    {% endif %}
                </span>
                <h3>{{ item.title }}</h3>
                <p>{{ item.text }}</p>
            </div>
        {% endfor %}
    </div>
</section>
{% endif %}
